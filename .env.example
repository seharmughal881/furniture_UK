# PostgreSQL connection string.
# Local:  postgresql://user:password@localhost:5432/atelier_3d
# Vercel: added automatically when you connect Neon (Storage tab). Use the pooled URL.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public address of the site, for the sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# AI image-to-3D (fal.ai). Get a key at https://fal.ai/dashboard/keys — leave empty to disable.
FAL_KEY=
# Model used to turn product photos into 3D (GLB). Hunyuan 3D 2.1 returns a textured GLB.
FAL_3D_MODEL=fal-ai/hunyuan3d-v21
# Safety limit: new 3D models that may be generated per day.
MAX_3D_PER_DAY=50

# Back office (/admin). Salt used to hash callers before they are counted in the
# rate_limits table, so no IP address or email is ever stored. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Optional: login throttling still works without it, but the buckets are then unsalted.
ADMIN_SESSION_SALT=

# Create the first staff account (there is no sign-up page):
#   npm run admin:create -- someone@mfi.om "Their Name"

# Image uploads for the back office (Vercel -> Storage -> Blob -> connect, then pull env).
# Without it the admin can still paste image addresses; the upload button is hidden.
BLOB_READ_WRITE_TOKEN=
