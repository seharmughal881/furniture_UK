# PostgreSQL connection string.
# Local:  postgresql://user:password@localhost:5432/atelier_3d
# Vercel: added automatically when you connect Neon (Storage tab). Use the pooled URL.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public address of the site, for the sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# AI image-to-3D (fal.ai). Get a key at https://fal.ai/dashboard/keys — leave empty to disable.
# fal.ai key, used by `npm run models:fal` to build 3D models from product photos.
#
# Careful where you put it. With FAL_KEY set, the PUBLIC /api/models/[slug] route will
# also start generating models for visitors browsing the planner, capped by
# MAX_3D_PER_DAY. Keep it to .env.local unless you want that on the live site.
FAL_KEY=
# Model used by `npm run models:fal`. SAM 3D Objects returns a watertight mesh and, with
# export_textured_glb, a real UV map and texture -- see scripts/models-fal.ts for why
# this one and not the others.
FAL_3D_MODEL_SAM=fal-ai/sam-3/3d-objects
# Model used by the on-demand /api/models/[slug] route (src/lib/models3d-core.ts).
# NOTE: fal marks hunyuan3d-v21 "no longer supported", so that route needs a new model
# before it can work again; models:fal does not use this value.
FAL_3D_MODEL=fal-ai/hunyuan3d-v21
# Safety limit: new 3D models that may be generated per day.
MAX_3D_PER_DAY=50

# Back office (/admin). Salt used to hash callers before they are counted in the
# rate_limits table, so no IP address or email is ever stored. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Optional: login throttling still works without it, but the buckets are then unsalted.
ADMIN_SESSION_SALT=

# Create the first staff account (there is no sign-up page):
#   npm run admin:create -- someone@mfi.om "Their Name"

# Image uploads for the back office (Vercel -> Storage -> Blob -> connect, then pull env).
# Without it the admin can still paste image addresses; the upload button is hidden.
BLOB_READ_WRITE_TOKEN=

# Card payments (AmwalPay: all cards, Apple Pay, Bank Muscat EPP).
# Leave MERCHANT_ID empty and the checkout shows the card option as "Coming soon" and
# will not let anyone pick it; cash on delivery keeps working either way.
# Fill these in only once you have the AmwalPay merchant account and their integration guide.
AMWALPAY_MERCHANT_ID=
AMWALPAY_TERMINAL_ID=
AMWALPAY_SECRET_KEY=
